# /etc/aether-edit/upload-s3.env  (0600)
# aether-edit OVH Object Storage credentials for the FT-2 upload service.
# Non-secret values are pre-filled below (US region, matching the OVH S3
# endpoint already used on this box). Replace the three PASTE_... values
# with the ones from the OVH console, save, then tell Cai "done".
# Cai never needs to see these in chat; the service reads them from here.
UPLOAD_S3_ENDPOINT=https://s3.us-west-or.io.cloud.ovh.us
UPLOAD_S3_REGION=us-west-or
UPLOAD_S3_PATH_STYLE=true
UPLOAD_S3_BUCKET=aether-edit-store
UPLOAD_S3_ACCESS_KEY=<redacted-secret-set-on-box>
UPLOAD_S3_SECRET_KEY=<redacted-secret-set-on-box>
