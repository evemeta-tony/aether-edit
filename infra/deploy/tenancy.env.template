# /etc/aether-edit/tenancy.env  (0600, owned aether-edit)
# FT-6a tenancy/auth/quota/metering/API-keys service configuration.
TENANCY_LISTEN_ADDR=127.0.0.1:9210
TENANCY_DATABASE_URL=postgres://aether_edit_app:<redacted>@127.0.0.1:5435/aether_edit?sslmode=disable
TENANCY_NATS_URL=nats://127.0.0.1:9214
TENANCY_AUTH_HS256_KEY=<redacted-secret-set-on-box>
TENANCY_INTERNAL_TOKEN=<redacted-secret-set-on-box>
TENANCY_TIERS_CONFIG_PATH=/etc/aether-edit/tiers.yaml
TENANCY_ACCESS_TOKEN_TTL=15m
TENANCY_REFRESH_TOKEN_TTL=720h
TENANCY_COOKIE_SECURE=true
# OIDC: issuer defaults to Google. Client id/secret/redirect are
# deploy-time secrets from Tony; PLACEHOLDER until provided, which is
# the login gate: discovery succeeds, logins cannot complete.
TENANCY_OIDC_ISSUER=https://accounts.google.com
TENANCY_OIDC_CLIENT_ID=<redacted-secret-set-on-box>
TENANCY_OIDC_CLIENT_SECRET=<redacted-secret-set-on-box>
TENANCY_OIDC_REDIRECT_URL=https://transcoder.evemeta.com/api/tenancy/v1/auth/callback
