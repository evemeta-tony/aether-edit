# /etc/aether-edit/oidc.env (template; secrets set on box)
PASTE_GOOGLE_CLIENT_ID# /etc/aether-edit/oidc.env  (0640)
# Google OAuth 2.0 Web-application client for the aether-edit console login.
# Replace both PASTE_ values with the ones from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID -> Web application),
# save, and tell Cai "done". Cai never needs to see these in chat.
TENANCY_OIDC_CLIENT_ID=<redacted-secret-set-on-box>
TENANCY_OIDC_CLIENT_SECRET=<redacted-secret-set-on-box>
