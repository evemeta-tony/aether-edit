# /etc/aether-edit/orchestrator.env (template; secrets set on box)
ORCH_HTTP_ADDR=127.0.0.1:9212
ORCH_DATABASE_URL=postgres://aether_edit_app:<redacted>@127.0.0.1:5435/aether_edit?sslmode=disable
ORCH_NATS_URL=nats://127.0.0.1:9214
ORCH_S3_ENDPOINT=https://s3.us-west-or.io.cloud.ovh.us
ORCH_S3_REGION=us-west-or
ORCH_S3_BUCKET=aether-edit-store
ORCH_S3_ACCESS_KEY=<redacted-secret-set-on-box>
ORCH_S3_SECRET_KEY=<redacted-secret-set-on-box>
ORCH_S3_PATH_STYLE=true
ORCH_SCRATCH_DIR=/var/lib/aether-edit/orch-scratch
ORCH_FFMPEG_PATH=/opt/aether-edit/ffmpeg/bin/ffmpeg
ORCH_FFPROBE_PATH=/opt/aether-edit/ffmpeg/bin/ffprobe
ORCH_QUOTA_CONFIG=/etc/aether-edit/quota.orchestrator.json
ORCH_JWT_SECRET=<redacted-secret-set-on-box>
ORCH_SCHEDULER_SLOTS=3
ORCH_AUTOCREATE_JOBS=true
