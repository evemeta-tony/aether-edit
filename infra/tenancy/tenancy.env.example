# infra/tenancy/tenancy.env.example
# Deploy-time environment for the tenancy service (systemd
# EnvironmentFile). Copy to the box, fill in secrets there; real
# values never enter the repo (S5).

TENANCY_LISTEN_ADDR=127.0.0.1:5401
TENANCY_DATABASE_URL=postgres://aether_tenancy:CHANGE_ME@127.0.0.1:5432/aether_tenancy
TENANCY_NATS_URL=nats://127.0.0.1:4222

# Shared HS256 key, base64url without padding, >= 32 bytes decoded.
# The SAME key goes to the FT-2 and FT-3 units so their middlewares
# verify tokens this service mints.
TENANCY_AUTH_HS256_KEY=CHANGE_ME_BASE64URL_32B

TENANCY_ACCESS_TOKEN_TTL=15m
TENANCY_REFRESH_TOKEN_TTL=720h

# Google OIDC (AM-3: GCP is identity only). Client created in the
# Google Cloud console; redirect URL must match exactly.
TENANCY_OIDC_ISSUER=https://accounts.google.com
TENANCY_OIDC_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
TENANCY_OIDC_CLIENT_SECRET=CHANGE_ME
TENANCY_OIDC_REDIRECT_URL=https://transcoder.evemeta.com/v1/auth/callback

TENANCY_TIERS_CONFIG_PATH=/etc/aether/plan-tiers.yaml

# Shared service-to-service token for /internal/v1 quota checks
# (FT-2 and FT-3 quotaclient). >= 16 chars.
TENANCY_INTERNAL_TOKEN=CHANGE_ME_INTERNAL

TENANCY_COOKIE_SECURE=true
