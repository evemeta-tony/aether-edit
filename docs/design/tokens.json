{
  "$schema": "platform-neutral design tokens — consumed by React (web), React Native, and the Skia canvas layer",
  "$version": "2.0.0",
  "$brand": "Aether",
  "$note": "Values are raw and platform-agnostic. Colors are 8-digit or 6-digit hex (no rgba() strings, no CSS-only constructs). Durations in ms, dimensions in dp/px.",

  "color": {
    "brand": {
      "blue700": "#1B4DD1",
      "blue600": "#2359E8",
      "blue500": "#2F6BF6",
      "blue400": "#4F86F7",
      "blue300": "#7FA8FA",
      "blueGlow": "#1C5BFE"
    },
    "dark": {
      "bgVoid": "#030506",
      "bgBase": "#0A0D11",
      "bgPanel": "#0F1318",
      "bgRaised": "#15181E",
      "bgInput": "#1A1E25",
      "bgHover": "#21262F",
      "line": "#FFFFFF14",
      "lineStrong": "#FFFFFF29",
      "fg1": "#FFFFFF",
      "fg2": "#FFFFFFAD",
      "fg3": "#FFFFFF70",
      "fg4": "#FFFFFF42"
    },
    "light": {
      "bgVoid": "#FFFFFF",
      "bgBase": "#F7F8FA",
      "bgPanel": "#FFFFFF",
      "bgRaised": "#FFFFFF",
      "bgInput": "#EFF1F5",
      "bgHover": "#E6E9EF",
      "line": "#0A0D1114",
      "lineStrong": "#0A0D1129",
      "fg1": "#0A0D11",
      "fg2": "#0A0D11B8",
      "fg3": "#0A0D1178",
      "fg4": "#0A0D1147"
    },
    "status": {
      "onair": "#E5334E",
      "ok": "#22C55E",
      "warn": "#F5A524",
      "err": "#EF4444",
      "idle": "#64748B"
    },
    "viz": ["#2F6BF6", "#4F86F7", "#22D3EE", "#A78BFA", "#22C55E", "#F5A524"],

    "edit": {
      "$note": "Aether Edit extends the core palette with a higher-energy creator range. Blue stays primary; these are for remix/challenge/celebration moments only.",
      "remix": "#8B5CF6",
      "remixBright": "#A78BFA",
      "hot": "#FF4D6D",
      "spark": "#FFC53D",
      "mint": "#2DD4A7",
      "selection": "#2F6BF6",
      "slot": "#8B5CF6",
      "snapGuide": "#FF4D6D",
      "spacingGuide": "#2DD4A7"
    }
  },

  "typography": {
    "family": {
      "$note": "The site's face reads as a Helvetica-Now / Neue Haas Grotesk class grotesque, but no font files were supplied. The system is authored against Inter, the closest web-available match. If Aether licenses the real face, prepend it to sans.",
      "sans": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Helvetica, Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "hero":    { "size": 64, "lineHeight": 1.02, "weight": 500, "tracking": -0.025 },
      "h1":      { "size": 44, "lineHeight": 1.06, "weight": 500, "tracking": -0.02 },
      "h2":      { "size": 32, "lineHeight": 1.12, "weight": 500, "tracking": -0.02 },
      "h3":      { "size": 22, "lineHeight": 1.2,  "weight": 600, "tracking": -0.02 },
      "stat":    { "size": 28, "lineHeight": 1.1,  "weight": 500, "tracking": -0.02 },
      "body":    { "size": 15, "lineHeight": 1.6,  "weight": 400, "tracking": 0 },
      "bodySm":  { "size": 13, "lineHeight": 1.55, "weight": 400, "tracking": 0 },
      "label":   { "size": 13, "lineHeight": 1.2,  "weight": 500, "tracking": 0 },
      "eyebrow": { "size": 11, "lineHeight": 1.1,  "weight": 600, "tracking": 0.14, "transform": "uppercase" },
      "button":  { "size": 12, "lineHeight": 1.0,  "weight": 600, "tracking": 0.09, "transform": "uppercase" },
      "nav":     { "size": 12, "lineHeight": 1.0,  "weight": 500, "tracking": 0.08 },
      "micro":   { "size": 11, "lineHeight": 1.3,  "weight": 500, "tracking": 0 },
      "mono":    { "size": 12, "lineHeight": 1.5,  "weight": 400, "tracking": 0 }
    },
    "mobileScale": {
      "$note": "Overrides at <768px. Everything not listed is unchanged.",
      "hero": { "size": 36 }, "h1": { "size": 28 }, "h2": { "size": 22 }, "h3": { "size": 18 }
    }
  },

  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },

  "radius": { "xs": 2, "sm": 4, "md": 6, "lg": 10, "xl": 14, "2xl": 20, "pill": 999 },

  "elevation": {
    "sm": { "y": 1, "blur": 2,  "color": "#00000066" },
    "md": { "y": 4, "blur": 16, "color": "#00000073" },
    "lg": { "y": 12, "blur": 40, "color": "#0000008C" },
    "button": { "y": 2, "blur": 14, "color": "#2F6BF65C" },
    "glowBlue": { "y": 0, "blur": 40, "color": "#1C5BFE73" }
  },

  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 400, "glow": 2400, "celebrate": 700 },
    "easing": {
      "standard": [0.4, 0, 0.2, 1],
      "out":      [0.16, 1, 0.3, 1],
      "in":       [0.4, 0, 1, 1],
      "spring":   [0.34, 1.56, 0.64, 1]
    }
  },

  "canvas": {
    "$note": "Spec-grade values for the Skia-rendered editing surface. All in CSS px at zoom=1; scale stroke widths by 1/zoom so they stay screen-constant.",
    "selection": {
      "boxStroke": 1.5, "boxColor": "#2F6BF6", "boxDash": null,
      "handleSize": 10, "handleRadius": 2, "handleFill": "#FFFFFF",
      "handleStroke": 1.5, "handleStrokeColor": "#2F6BF6",
      "handleHitArea": 44,
      "rotationOffset": 28, "rotationHandleRadius": 7,
      "multiSelectStroke": 1.5, "multiSelectDash": [4, 4]
    },
    "guides": {
      "snapStroke": 1, "snapColor": "#FF4D6D", "snapDash": [6, 4],
      "spacingStroke": 1, "spacingColor": "#2DD4A7", "spacingDash": [3, 3],
      "spacingLabelSize": 11, "spacingLabelBg": "#2DD4A7", "spacingLabelFg": "#03130E",
      "snapThreshold": 6
    },
    "slot": {
      "$note": "Remix slots — the media the forker replaces.",
      "stroke": 2, "color": "#8B5CF6", "dash": [8, 5], "radius": 6,
      "fillTint": "#8B5CF61F", "pulseDuration": 1600, "labelSize": 11
    },
    "text": {
      "caretWidth": 2, "caretColor": "#FFFFFF", "caretBlink": 530,
      "selectionFill": "#2F6BF659", "boundsStroke": 1, "boundsColor": "#2F6BF6"
    },
    "crop": {
      "gridStroke": 1, "gridColor": "#FFFFFF59", "cornerLength": 22,
      "cornerStroke": 3, "cornerColor": "#FFFFFF", "scrimColor": "#00000099"
    },
    "locked": { "stroke": 1.5, "color": "#64748B", "dash": [3, 3], "iconSize": 14 },
    "error":  { "stroke": 1.5, "color": "#EF4444", "dash": null, "tint": "#EF44441F" },
    "safeZone": {
      "$note": "Platform UI overlays shown in export preview.",
      "scrimColor": "#00000073", "borderStroke": 1, "borderColor": "#FFFFFF66",
      "borderDash": [5, 4], "labelSize": 10
    },
    "zOrder": ["artboard", "content", "slotHighlight", "spacingGuides", "snapGuides", "selectionBox", "textCaret", "handles", "safeZone"]
  },

  "a11y": {
    "minTouchTarget": 44,
    "minContrastBodyOnDark": 4.5,
    "minContrastLargeOnDark": 3.0,
    "focusRingWidth": 2,
    "focusRingColor": "#4F86F7",
    "focusRingOffset": 2
  }
}
